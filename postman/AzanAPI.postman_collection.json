{
  "info": {
    "_postman_id": "3a122132-2d0e-4bc5-a021-500ef353c45c",
    "name": "AzanAPI verification",
    "description": "Manual checks matching the API test suite. Requests default to the production API; set base_url to a local or self-hosted URL when needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.aakashsharma.com.np"
    }
  ],
  "item": [
    {
      "name": "Service",
      "item": [
        {
          "name": "Root — service information (200)",
          "request": { "method": "GET", "url": "{{base_url}}/" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Service is running', () => pm.expect(pm.response.json()).to.include({ status: 'running' }));"] }}]
        },
        {
          "name": "Health — healthy (200)",
          "request": { "method": "GET", "url": "{{base_url}}/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Healthy response', () => pm.expect(pm.response.json()).to.eql({ status: 'healthy' }));"] }}]
        }
      ]
    },
    {
      "name": "Prayer-time successes",
      "item": [
        {
          "name": "Reference case — North America / Hanafi (200)",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/prayer-times?latitude=35.775&longitude=-78.6336&timezone=America%2FNew_York&date=2015-07-12&calculation_method=north_america&madhab=hanafi" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Reference times', () => pm.expect(pm.response.json().calculated_times).to.eql({ fajr: '04:42', sunrise: '06:08', dhuhr: '13:21', asr: '18:22', sunset: '20:32', maghrib: '20:32', isha: '21:57' }));"] }}]
        },
        {
          "name": "Dubai — positive Fajr and Isha adjustments (200)",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/prayer-times?latitude=25.2048&longitude=55.2708&timezone=Asia%2FDubai&date=2026-09-15&calculation_method=dubai&madhab=shafi&fajr_adjustment=2&isha_adjustment=10" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Only Azan values change', () => { const b = pm.response.json(); pm.expect(b.calculated_times.fajr).to.eql('04:47'); pm.expect(b.azan_times.fajr).to.eql('04:49'); pm.expect(b.calculated_times.isha).to.eql('19:41'); pm.expect(b.azan_times.isha).to.eql('19:51'); });"] }}]
        },
        {
          "name": "Dubai — negative Maghrib adjustment (200)",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/prayer-times?latitude=25.2048&longitude=55.2708&timezone=Asia%2FDubai&date=2026-09-15&calculation_method=dubai&maghrib_adjustment=-3" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Maghrib is three minutes earlier', () => { const b = pm.response.json(); pm.expect(b.calculated_times.maghrib).to.eql('18:26'); pm.expect(b.azan_times.maghrib).to.eql('18:23'); });"] }}]
        },
        {
          "name": "Isha midnight rollover (200)",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/prayer-times?latitude=35.775&longitude=-78.6336&timezone=America%2FNew_York&date=2015-07-12&calculation_method=north_america&madhab=hanafi&isha_adjustment=150" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Isha rolls over midnight', () => { const b = pm.response.json(); pm.expect(b.calculated_times.isha).to.eql('21:57'); pm.expect(b.azan_times.isha).to.eql('00:27'); });"] }}]
        }
      ]
    },
    {
